MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/  # from the hackathon Atlas Sandbox
MONGODB_DB=privacy_agent
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_API_KEY=
LLM_MODEL=                      # a small, cheap model is enough
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite    # embeddings for precedents (Vector Search)
VOYAGE_DIMS=1024                # must match the precedents_vec index
# k threshold, memory scope and retention live in the active policy (scripts/seed_policies.py)
